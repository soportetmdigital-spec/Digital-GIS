<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fiber_gis" model="ir.module.category">
        <field name="name">Fiber GIS</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_fiber_gis" model="res.groups.privilege">
        <field name="name">Fiber GIS</field>
        <field name="category_id" ref="module_category_fiber_gis"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_fiber_gis_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_fiber_gis"/>
    </record>

    <record id="group_fiber_gis_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="privilege_fiber_gis"/>
        <field name="implied_ids" eval="[(4, ref('group_fiber_gis_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_fiber_gis_user'))]"/>
    </record>
</odoo>
