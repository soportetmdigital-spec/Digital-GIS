<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_cable_pass_review_form" model="ir.ui.view">
        <field name="name">fiber.gis.cable.pass.review.form</field>
        <field name="model">fiber.gis.cable.pass.review</field>
        <field name="arch" type="xml">
            <form string="Revisar cables de paso">
                <sheet>
                    <p class="text-muted" invisible="not node_id">
                        Cables cuyo recorrido pasa por este elemento sin terminar en él. Marca «Dejar de paso» y pulsa
                        «Dejar de paso los marcados»: el cable se divide en el elemento y sus fibras se registran de paso
                        en la bandeja 1 (si no tiene bandejas, se crea una).
                    </p>
                    <p class="text-muted" invisible="node_id">
                        Busca cables cuyo recorrido pasa sobre un elemento que no es su origen ni su destino.
                        Marca «Dejar de paso» en los cruces donde el cable debe quedar de paso dentro del elemento:
                        el cable se divide en ese elemento y sus fibras se registran de paso en la bandeja 1
                        (si el elemento no tiene bandejas, se crea una).
                    </p>
                    <group>
                        <field name="node_id" invisible="not node_id"/>
                        <field name="tolerance_m"/>
                        <field name="filter_text" placeholder="Cable o elemento (opcional)" invisible="node_id"/>
                    </group>
                    <field name="searched" invisible="1"/>
                    <div class="mb-3">
                        <button name="action_search" type="object" string="Buscar cables que atraviesan elementos" class="btn-primary"/>
                    </div>
                    <field name="result_message" invisible="not result_message" nolabel="1"/>
                    <field name="line_ids" invisible="not searched" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="cable_id" readonly="1"/>
                            <field name="node_id" readonly="1"/>
                            <field name="distance_m" readonly="1"/>
                            <field name="leave_pass" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Dejar de paso los marcados" class="btn-primary" invisible="not line_ids"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fiber_gis_cable_pass_review" model="ir.actions.act_window">
        <field name="name">Revisar cables de paso</field>
        <field name="res_model">fiber.gis.cable.pass.review</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fiber_gis_cable_pass_review_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_fiber_gis_cable_pass_review"
        name="Revisar cables de paso"
        parent="menu_fiber_gis_config"
        action="action_fiber_gis_cable_pass_review"
        sequence="5"
        groups="fiber_gis.group_fiber_gis_manager"/>
</odoo>
