<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_manhole_type_list" model="ir.ui.view">
        <field name="name">fiber.gis.manhole.type.list</field>
        <field name="model">fiber.gis.manhole.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="manufacturer"/>
                <field name="length_cm"/>
                <field name="width_cm"/>
                <field name="depth_cm"/>
                <field name="usual_use"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fiber_gis_manhole_type_form" model="ir.ui.view">
        <field name="name">fiber.gis.manhole.type.form</field>
        <field name="model">fiber.gis.manhole.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de arqueta">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="manufacturer"/>
                            <field name="standard_reference"/>
                            <field name="usual_use"/>
                        </group>
                        <group string="Medidas interiores">
                            <field name="length_cm"/>
                            <field name="width_cm"/>
                            <field name="depth_cm"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiber_gis_manhole_type" model="ir.actions.act_window">
        <field name="name">Tipos de arqueta</field>
        <field name="res_model">fiber.gis.manhole.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fiber_gis_manhole_type"
        name="Tipos de arqueta"
        parent="menu_fiber_gis_config"
        action="action_fiber_gis_manhole_type"
        sequence="15"/>
</odoo>
