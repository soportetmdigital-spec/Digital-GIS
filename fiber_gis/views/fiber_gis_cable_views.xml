<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_cable_list" model="ir.ui.view">
        <field name="name">fiber.gis.cable.list</field>
        <field name="model">fiber.gis.cable</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="previous_name" optional="hide"/>
                <field name="deployment_plan_id" optional="hide"/>
                <field name="color" widget="fiber_color"/>
                <field name="from_node_id"/>
                <field name="from_boca" optional="hide"/>
                <field name="to_node_id"/>
                <field name="to_boca" optional="hide"/>
                <field name="route_kind"/>
                <field name="fiber_count" string="Fibras / fibras por tubo"/>
                <field name="tube_count"/>
                <field name="fibers_per_tube"/>
                <field name="total_fiber_count"/>
                <field name="length_m"/>
                <field name="installation_employee_ids" widget="many2many_tags" optional="hide" options="{'no_create': True, 'no_open': True}"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fiber_gis_cable_form" model="ir.ui.view">
        <field name="name">fiber.gis.cable.form</field>
        <field name="model">fiber.gis.cable</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_map" type="object" string="Abrir en mapa" class="btn-primary"/>
                    <button name="action_generate_fibers" type="object" string="Generar fibras" class="btn-primary"/>
                    <button name="action_open_tray_wizard" type="object" string="Registrar en bandeja" class="btn-secondary"/>
                    <button name="action_sync_route_segments" type="object" string="Actualizar tramos"/>
                    <button name="action_set_planned" type="object" string="Planificar"/>
                    <button name="action_set_installed" type="object" string="Instalar"/>
                    <button name="action_set_active" type="object" string="Activar" class="btn-primary"/>
                    <button name="action_set_fault" type="object" string="Incidencia"/>
                    <button name="action_set_retired" type="object" string="Retirar"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,installed,active,fault,retired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="type_id" string="Tipología del GIS"/>
                            <field name="profile_id" string="Tipología del cable" options="{'no_quick_create': True}"/>
                            <field name="topology" string="Detalle de la tipología" readonly="1"/>
                            <field name="deployment_plan_id"/>
                            <field name="color" widget="fiber_color"/>
                            <field name="route_kind"/>
                            <field name="from_node_id"/>
                            <field name="to_node_id"/>
                            <field name="from_boca"/>
                            <field name="to_boca"/>
                        </group>
                        <group>
                            <field name="tube_count" readonly="profile_id"/>
                            <field name="total_fiber_count" string="Total de fibras" readonly="1"/>
                            <field name="fiber_count" string="Fibras / fibras por tubo" readonly="profile_id"/>
                            <field name="install_date"/>
                            <field name="installation_employee_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                            <field name="measured_length_m"/>
                            <field name="length_m" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tramos">
                            <field name="segment_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="from_label" readonly="1"/>
                                    <field name="to_label" readonly="1"/>
                                    <field name="route_kind"/>
                                    <field name="length_m" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fibras">
                            <field name="fiber_ids">
                                <list create="0" delete="0">
                                    <field name="number"/>
                                    <field name="tube" column_invisible="parent.tube_count &lt;= 1"/>
                                    <field name="tube_color" string="Color del tubo" widget="fiber_color" readonly="1" column_invisible="parent.tube_count &lt;= 1"/>
                                    <field name="color" string="Color de la fibra" widget="fiber_color" readonly="1"/>
                                    <field name="from_connection_summary"/>
                                    <field name="to_connection_summary"/>
                                    <field name="attenuation_db" optional="hide"/>
                                    <field name="state" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Geometr&#xED;a">
                            <group>
                                <field name="from_latitude" readonly="1"/>
                                <field name="from_longitude" readonly="1"/>
                                <field name="to_latitude" readonly="1"/>
                                <field name="to_longitude" readonly="1"/>
                            </group>
                            <field name="geometry_geojson" placeholder='{"type":"LineString","coordinates":[[-3.7038,40.4168],[-3.7045,40.4171]]}'/>
                            <field name="route_segment_kinds" invisible="1"/>
                        </page>
                        <page string="Técnico">
                            <field name="work_log_ids">
                                <list editable="bottom">
                                    <field name="date" string="Día y hora"/>
                                    <field name="employee_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="employee_name" optional="hide"/>
                                    <field name="user_id" readonly="1" optional="hide"/>
                                    <field name="work_type" string="Trabajo"/>
                                    <field name="description" string="Trabajo realizado" required="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fiber_gis_cable_fiber_form" model="ir.ui.view">
        <field name="name">fiber.gis.cable.fiber.form</field>
        <field name="model">fiber.gis.cable.fiber</field>
        <field name="arch" type="xml">
            <form string="Fibra del cable" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="cable_id" readonly="1"/>
                            <field name="number" readonly="1"/>
                            <field name="show_tube" invisible="1"/>
                            <field name="tube" readonly="1" invisible="not show_tube"/>
                            <field name="tube_color" widget="fiber_color" readonly="1" invisible="not show_tube"/>
                            <field name="color" widget="fiber_color" readonly="1"/>
                        </group>
                        <group>
                            <field name="attenuation_db"/>
                            <field name="state"/>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="work_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Origen"><field name="from_connection_summary" nolabel="1" readonly="1"/></group>
                        <group string="Destino"><field name="to_connection_summary" nolabel="1" readonly="1"/></group>
                    </group>
                    <field name="notes" string="Observaciones"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiber_gis_cable" model="ir.actions.act_window">
        <field name="name">Cables</field>
        <field name="res_model">fiber.gis.cable</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fiber_gis_cable" name="Cables" parent="menu_fiber_gis_inventory" action="action_fiber_gis_cable" sequence="30"/>
</odoo>
