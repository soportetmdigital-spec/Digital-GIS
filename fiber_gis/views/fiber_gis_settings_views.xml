<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_settings_wizard_form" model="ir.ui.view">
        <field name="name">fiber.gis.settings.wizard.form</field>
        <field name="model">fiber.gis.settings.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajustes de Fiber GIS">
                <sheet>
                    <group string="Version">
                        <field name="module_version" readonly="1"/>
                    </group>
                    <group string="Mapa">
                        <field name="map_detail_zoom"/>
                        <div class="text-muted">A partir de este nivel se muestran los iconos y nombres completos de los elementos.</div>
                    </group>
                    <group string="OpenStreetMap / Nominatim">
                        <field name="fiber_gis_nominatim_url"/>
                        <field name="fiber_gis_nominatim_email"/>
                        <div class="text-muted">Geocodificaci&#xF3;n &#xA9; OpenStreetMap contributors</div>
                    </group>
                    <group string="CTO">
                        <button
                            name="action_update_cto_colors"
                            type="object"
                            string="Actualizar colores CTO"
                            class="btn-secondary"/>
                    </group>
                    <group string="Fibras">
                        <button
                            name="action_recompute_fiber_states"
                            type="object"
                            string="Recalcular estados de fibras"
                            class="btn-secondary"/>
                    </group>
                    <group string="Copias de seguridad">
                        <button
                            name="action_create_backup"
                            type="object"
                            string="Crear copia de seguridad"
                            class="btn-primary"/>
                        <field name="backup_file" filename="backup_filename" widget="binary" options="{'preview_image': False, 'accepted_file_extensions': '.zip'}"/>
                        <div class="text-warning">La restauraci&#xF3;n borra los datos actuales de Fiber GIS antes de importar la copia.</div>
                        <button
                            name="action_restore_backup"
                            type="object"
                            string="Restaurar copia"
                            class="btn-secondary"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Guardar" type="object" name="action_save_settings" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fiber_gis_settings" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">fiber.gis.settings.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fiber_gis_settings_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_fiber_gis_settings"
        name="Ajustes"
        parent="menu_fiber_gis_config"
        action="action_fiber_gis_settings"
        sequence="1"
        groups="-fiber_gis.group_fiber_gis_manager"/>
</odoo>
