<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_tray_list" model="ir.ui.view">
        <field name="name">fiber.gis.tray.list</field>
        <field name="model">fiber.gis.tray</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="node_id"/>
                <field name="used_positions"/>
            </list>
        </field>
    </record>

    <record id="view_fiber_gis_tray_form" model="ir.ui.view">
        <field name="name">fiber.gis.tray.form</field>
        <field name="model">fiber.gis.tray</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="node_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="used_positions" readonly="1" string="Trabajos registrados"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenido">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="position"/>
                                    <field name="line_type"/>
                                    <field name="input_cable_id" readonly="1"/>
                                    <field name="input_tube" readonly="1"/>
                                    <field name="input_tube_color" widget="fiber_color" readonly="1"/>
                                    <field name="input_fiber_number" readonly="1"/>
                                    <field name="input_fiber_color" widget="fiber_color" readonly="1"/>
                                    <field name="input_fiber_id"/>
                                    <field name="output_cable_id" readonly="1"/>
                                    <field name="output_tube" readonly="1"/>
                                    <field name="output_tube_color" widget="fiber_color" readonly="1"/>
                                    <field name="output_fiber_number" readonly="1"/>
                                    <field name="output_fiber_color" widget="fiber_color" readonly="1"/>
                                    <field name="output_fiber_id"/>
                                    <field name="splitter_id"/>
                                    <field name="splitter_ratio"/>
                                    <field name="loss_db"/>
                                    <field name="work_date"/>
                                    <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiber_gis_tray" model="ir.actions.act_window">
        <field name="name">Bandejas</field>
        <field name="res_model">fiber.gis.tray</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'node_id'}</field>
    </record>

    <menuitem id="menu_fiber_gis_tray" name="Bandejas" parent="menu_fiber_gis_operations" action="action_fiber_gis_tray" sequence="10"/>
</odoo>
