<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_cable_profile_list" model="ir.ui.view">
        <field name="name">fiber.gis.cable.profile.list</field>
        <field name="model">fiber.gis.cable.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
