                <field name="tube_count"/>
                <field name="fiber_count" string="Fibras / fibras por tubo"/>
                <field name="total_fiber_count"/>
            </list>
        </field>
    </record>
    <record id="view_fiber_gis_cable_profile_form" model="ir.ui.view">
        <field name="name">fiber.gis.cable.profile.form</field>
        <field name="model">fiber.gis.cable.profile</field>
        <field name="arch" type="xml">
            <form string="Tipolog&#237;a de cable">
                <sheet>
                    <group>
