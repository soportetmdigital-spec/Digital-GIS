<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiber_gis_node_category_list" model="ir.ui.view">
        <field name="name">fiber.gis.node.category.list</field>
        <field name="model">fiber.gis.node.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="node_kind"/>
                <field name="color" widget="fiber_color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fiber_gis_node_category_form" model="ir.ui.view">
        <field name="name">fiber.gis.node.category.form</field>
        <field name="model">fiber.gis.node.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="node_kind"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="map_icon" widget="fiber_icon_select"/>
                            <field name="color" widget="fiber_color"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tipos de funci&#243;n">
                            <field name="function_type_ids" context="{'default_category': 'node'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category" column_invisible="True"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiber_gis_node_category" model="ir.actions.act_window">
        <field name="name">Modelos</field>
        <field name="res_model">fiber.gis.node.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fiber_gis_node_category" name="Modelos" parent="menu_fiber_gis_config" action="action_fiber_gis_node_category" sequence="5"/>
</odoo>
