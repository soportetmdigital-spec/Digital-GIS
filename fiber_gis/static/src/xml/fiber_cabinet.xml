<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fiber_gis.FiberGisCabinet">
        <div class="o_fiber_cabinet">
            <div class="o_fiber_cabinet_topbar">
                <div class="o_fiber_cabinet_brand"><span class="o_fiber_cabinet_brand_icon"><i class="fa fa-server"/></span><div><small>FIBER GIS / INFRAESTRUCTURA</small><h1 t-esc="state.data ? state.data.name : 'Cabecera'"/></div></div>
                <div class="o_fiber_cabinet_topmetrics" t-if="state.data"><span><strong t-esc="equipment.length"/> equipos</span><span><strong t-esc="racks.length"/> racks</span><span><strong t-esc="connectedCount"/> fibras conectadas</span></div>
                <button class="btn btn-light" t-on-click="openCabinetList"><i class="fa fa-th-list me-1"/> Cabeceras</button>
            </div>
            <div t-if="state.loading" class="o_fiber_cabinet_loading"><i class="fa fa-circle-o-notch fa-spin"/> Preparando el rack…</div>
            <div t-elif="!state.data" class="o_fiber_cabinet_empty"><h2>Selecciona una cabecera</h2><p>Vuelve al listado para abrir un armario configurado.</p><button class="btn btn-primary" t-on-click="openCabinetList">Abrir cabeceras</button></div>
            <div t-else="" class="o_fiber_cabinet_workspace" t-att-class="state.saving ? 'is-saving' : ''">
                <aside class="o_fiber_cabinet_library">
                    <div class="o_fiber_cabinet_section_title"><div><small>COMPONENTES</small><h2>Biblioteca</h2></div><span class="o_fiber_cabinet_count" t-esc="catalog.length"/></div>
                    <div class="o_fiber_cabinet_search"><i class="fa fa-search"/><input placeholder="Buscar componente…" t-on-input="onSearch" t-att-value="state.query"/></div>
                    <div class="o_fiber_cabinet_library_list">
                        <div t-foreach="catalog" t-as="item" t-key="item.kind" class="o_fiber_cabinet_catalog_item" draggable="true" role="button" tabindex="0" t-on-dragstart="(ev) => this.onCatalogDragStart(ev, item)" t-on-click="() => this.addEquipment(item.kind)" t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.addEquipment(item.kind)">
                            <img t-if="equipmentImage(item)" class="o_fiber_cabinet_catalog_product_photo" t-att-src="equipmentImage(item)" t-att-alt="item.name" loading="lazy"/>
                            <span t-else="" t-att-class="'o_fiber_cabinet_catalog_icon is-' + item.kind"><i t-att-class="kindIcon(item.kind)"/></span>
                            <span class="o_fiber_cabinet_catalog_text"><strong t-esc="item.name"/><small><t t-esc="item.height_u"/> U <t t-if="item.port_count">· <t t-esc="item.port_count"/> bocas</t></small></span><span class="o_fiber_cabinet_catalog_actions"><i class="fa fa-plus o_fiber_cabinet_add"/><button type="button" class="o_fiber_cabinet_catalog_edit" title="Editar elemento de biblioteca" t-on-click.stop="() => this.openCatalogEditor(item)"><i class="fa fa-pencil"/></button></span>
                        </div>
                    </div>
                    <div class="o_fiber_cabinet_library_hint"><i class="fa fa-lightbulb-o"/><span>Arrastra un componente al rack o pulsa para añadirlo al espacio disponible.</span></div>
                </aside>
                <main class="o_fiber_cabinet_center">
                    <div class="o_fiber_cabinet_canvas_head"><div><small>VISTA FRONTAL</small><h2><t t-esc="racks.length"/> armario(s) rack</h2></div><span class="o_fiber_cabinet_live"><i/> Sincronizado</span></div>
                    <div class="o_fiber_cabinet_scroll_tools"><span><i class="fa fa-arrows-v me-1"/>Vista completa · <strong t-esc="Math.round(state.zoom * 100)"/>%</span><div class="o_fiber_cabinet_zoom"><button class="btn btn-sm btn-light" title="Reducir vista" t-on-click="() => this.state.zoom = Math.max(0.6, Math.round((state.zoom - 0.1) * 10) / 10)"><i class="fa fa-search-minus"/></button><input type="range" min="0.6" max="1.4" step="0.1" t-att-value="state.zoom" t-on-input="setZoom" aria-label="Ampliar o reducir la vista del rack"/><button class="btn btn-sm btn-light" title="Ampliar vista" t-on-click="() => this.state.zoom = Math.min(1.4, Math.round((state.zoom + 0.1) * 10) / 10)"><i class="fa fa-search-plus"/></button><button class="btn btn-sm btn-light" title="Subir" t-on-click="() => this.scrollRack(-1)"><i class="fa fa-chevron-up"/></button><button class="btn btn-sm btn-light" title="Bajar" t-on-click="() => this.scrollRack(1)"><i class="fa fa-chevron-down"/></button><button class="btn btn-sm btn-primary" t-on-click="addRack"><i class="fa fa-plus me-1"/>Añadir rack</button></div></div>
                    <div class="o_fiber_cabinet_canvas_scroll"><div class="o_fiber_cabinet_racks" t-att-style="'zoom:' + state.zoom">
                    <canvas class="o_fiber_cabinet_connection_layer" aria-label="Recorrido de cables entre bocas" role="img"/>
                    <div t-foreach="racks" t-as="rack" t-key="rack.id" t-att-class="'o_fiber_cabinet_rack_column o_fiber_gis_rack_position' + (state.activeRackId === rack.id ? ' is-active' : '')" t-att-data-rack-id="rack.id">
                        <div class="o_fiber_cabinet_rack_heading"><strong t-esc="rack.name"/><button type="button" t-on-click="() => this.selectRack(rack)" t-att-title="state.activeRackId === rack.id ? 'Rack seleccionado para añadir componentes' : 'Seleccionar para añadir componentes'"><i t-att-class="state.activeRackId === rack.id ? 'fa fa-check' : 'fa fa-crosshairs'"/></button></div>
                        <div class="o_fiber_cabinet_rack_shell" t-att-style="'height:' + (rack.height_u * 44 + 30) + 'px'">
                        <div t-att-class="'o_fiber_cabinet_remove_zone' + (state.draggingEquipmentId ? ' is-active' : '')" t-on-dragover="(ev) => ev.preventDefault()" t-on-drop="removeEquipmentFromRack"><i class="fa fa-arrow-left"/><span>Suelta aquí para retirar</span></div>
                        <div class="o_fiber_cabinet_rail left"><t t-foreach="units(rack)" t-as="unit" t-key="'l' + unit"><span><t t-esc="unit"/></span></t></div>
                        <div class="o_fiber_cabinet_rack" t-att-data-rack-id="rack.id" t-att-style="'height:' + (rack.height_u * 44 + 2) + 'px'" t-on-dragover="(ev) => ev.preventDefault()" t-on-drop="onRackDrop">
                            <div t-foreach="units(rack)" t-as="unit" t-key="unit" class="o_fiber_cabinet_u_slot"><span>U<t t-esc="unit"/></span><span class="o_fiber_cabinet_screws"><i/><i/></span></div>
                            <div t-foreach="rack.equipment" t-as="item" t-key="item.id" t-att-class="'o_fiber_cabinet_equipment is-' + item.kind + (state.selectedEquipment?.id === item.id ? ' is-selected' : '')" t-att-style="equipmentStyle(item)" t-att-aria-label="item.name" draggable="true" role="group" tabindex="0" t-on-dragstart="(ev) => this.onEquipmentDragStart(ev, item)" t-on-dragend="onEquipmentDragEnd" t-on-click="() => this.selectEquipment(item)" t-on-keydown="(ev) => this.onEquipmentKeydown(ev, item)">
                                <span class="o_fiber_cabinet_face">
                                    <img t-if="equipmentImage(item)" class="o_fiber_cabinet_product_photo" t-att-src="equipmentImage(item)" t-att-alt="item.name" loading="lazy"/>
                                    <span t-if="!equipmentImage(item)" class="o_fiber_cabinet_brandmark"><i t-att-class="kindIcon(item.kind)"/></span>
                                    <span class="o_fiber_cabinet_equipment_info" t-att-style="equipmentInfoStyle(item)"><strong t-esc="item.name"/><small>U<t t-esc="item.position_u"/> · <t t-esc="item.height_u"/>U<t t-if="item.port_count"> · <t t-esc="item.port_count"/> bocas</t></small></span>
                                    <span t-if="connectedInterconnections(item)" class="o_fiber_cabinet_link_badge" t-att-title="connectedInterconnections(item) + ' interconexión(es)'"><i class="fa fa-link"/> <t t-esc="connectedInterconnections(item)"/></span>
                                    <span t-if="!equipmentImage(item) &amp;&amp; (item.kind === 'server' || item.kind === 'nas' || item.kind === 'ups')" class="o_fiber_cabinet_drive_bays"><i/><i/><i/><i/></span>
                                    <span t-if="!equipmentImage(item) &amp;&amp; item.kind == 'fan_panel'" class="o_fiber_cabinet_fanrow"><i/><i/><i/><i/></span>
                                    <span t-if="!equipmentImage(item) &amp;&amp; item.kind == 'pdu'" class="o_fiber_cabinet_pdu_sockets"><i/><i/><i/><i/><i/></span>
                                    <span t-if="!equipmentImage(item) &amp;&amp; (item.kind === 'shelf' || item.kind === 'shelf_sliding')" class="o_fiber_cabinet_shelf_lip"/>
                                    <span t-if="!equipmentImage(item) &amp;&amp; item.kind == 'cable_manager'" class="o_fiber_cabinet_cable_fingers"><i/><i/><i/><i/><i/><i/><i/><i/></span>
                                    <button t-foreach="equipmentPorts(item)" t-as="port" t-key="port.number" type="button" t-att-data-equipment-id="item.id" t-att-data-port-number="port.number" t-att-class="'o_fiber_cabinet_port_hotspot' + (equipmentImage(item) ? ' has-photo' : ' generic') + (item.kind === 'fhu_panel_48f' || item.kind === 'patch_panel' ? ' single-row' : '') + (port.fiberPort?.fiber_id ? ' has-fiber' : '') + (isInterconnectionPortOccupied(item, port.number) ? ' is-connected' : '') + (state.selectedPort?.equipmentId === item.id &amp;&amp; state.selectedPort?.port === port.number ? ' is-source' : '')" t-att-style="visualPortStyle(item, port)" t-att-title="portTitle(item, port)" t-att-aria-label="portTitle(item, port)" t-on-click="(ev) => this.onVisualPortClick(ev, item, port)"><t t-esc="port.number"/></button>
                                    <span class="o_fiber_cabinet_leds"><i/><i/><i/></span>
                                    <span t-if="!equipmentImage(item)" class="o_fiber_cabinet_screws"><i/><i/><i/><i/></span>
                                </span>
                            </div>
                        </div>
                        <div class="o_fiber_cabinet_rail right"><t t-foreach="units(rack)" t-as="unit" t-key="'r' + unit"><span><t t-esc="unit"/></span></t></div>
                    </div></div>
                    </div></div>
                    <div class="o_fiber_cabinet_connection_hint" t-if="state.selectedPort"><i class="fa fa-link"/> Boca <strong t-esc="state.selectedPort.port"/> de <strong t-esc="state.selectedPort.equipmentName"/> seleccionada. Pulsa una boca libre de otro equipo.</div>
                    <div class="o_fiber_cabinet_connection_hint" t-else=""><i class="fa fa-hand-pointer-o"/> Para cablear, pulsa una boca del frontal y después la boca de destino.</div>
                    <div class="o_fiber_cabinet_canvas_foot"><span><i class="fa fa-arrows-v"/> <t t-esc="racks.length"/> racks de <t t-esc="racks[0]?.height_u || 0"/> U</span><span>Arrastra equipos para moverlos entre racks o retirarlos</span></div>
                </main>
                <aside class="o_fiber_cabinet_inspector">
                    <t t-if="state.selectedEquipment">
                        <div class="o_fiber_cabinet_inspector_head"><span t-att-class="'o_fiber_cabinet_catalog_icon is-' + state.selectedEquipment.kind"><i t-att-class="kindIcon(state.selectedEquipment.kind)"/></span><div><small>DETALLE DEL EQUIPO</small><h2 t-esc="state.selectedEquipment.name"/></div></div>
                        <label class="o_fiber_cabinet_name_label">Nombre del equipo<input class="o_fiber_cabinet_equipment_name_input" type="text" maxlength="120" t-att-value="state.equipmentNameDraft" t-on-input="onEquipmentNameInput" t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.saveEquipmentName(ev)"/></label>
                        <button class="btn btn-sm btn-outline-primary o_fiber_cabinet_save_name" t-att-disabled="state.saving || !state.equipmentNameDraft.trim()" t-on-click="saveEquipmentName"><i class="fa fa-check me-1"/>Guardar nombre</button>
                        <div class="o_fiber_cabinet_inspector_meta"><div><small>Posición</small><strong>U<t t-esc="state.selectedEquipment.position_u"/></strong></div><div><small>Altura</small><strong><t t-esc="state.selectedEquipment.height_u"/> U</strong></div><div><small>Puertos</small><strong t-esc="state.selectedEquipment.port_count"/></div></div>
                        <section t-if="state.selectedEquipment.port_count" class="o_fiber_cabinet_interconnection"><div class="o_fiber_cabinet_patch_title"><div><small>CABLEADO INTERNO</small><h3>Interconexiones</h3></div><span t-esc="selectedInterconnections.length"/></div>
                            <label>Equipo de destino<select t-att-value="state.interconnectionDraft.targetId" t-on-change="(ev) => this.onInterconnectionInput(ev, 'targetId')"><option value="">Seleccionar equipo…</option><option t-foreach="allEquipment" t-as="target" t-key="target.id" t-if="target.id !== state.selectedEquipment.id &amp;&amp; target.port_count" t-att-value="target.id"><t t-esc="target.name"/> · <t t-esc="rackName(target.rack_id)"/></option></select></label>
                            <div class="o_fiber_cabinet_link_ports"><label>Boca de este equipo<input type="number" min="1" t-att-max="state.selectedEquipment.port_count" t-att-value="state.interconnectionDraft.fromPort" t-on-input="(ev) => this.onInterconnectionInput(ev, 'fromPort')"/></label><label>Boca destino<input type="number" min="1" t-att-value="state.interconnectionDraft.toPort" t-on-input="(ev) => this.onInterconnectionInput(ev, 'toPort')"/></label></div>
                            <label>Tipo de cable<select t-att-value="state.interconnectionDraft.cableType" t-on-change="(ev) => this.onInterconnectionInput(ev, 'cableType')"><option value="ethernet">Ethernet / cobre</option><option value="fiber">Fibra óptica</option><option value="dac">DAC / twinaxial</option><option value="other">Otro</option></select></label>
                            <label>Identificación<input type="text" maxlength="120" placeholder="Opcional" t-att-value="state.interconnectionDraft.name" t-on-input="(ev) => this.onInterconnectionInput(ev, 'name')"/></label>
                            <button type="button" class="btn btn-sm btn-primary" t-att-disabled="state.saving || !state.interconnectionDraft.targetId" t-on-click="createInterconnection"><i class="fa fa-link me-1"/>Añadir conexión</button>
                            <div t-if="selectedInterconnections.length" class="o_fiber_cabinet_link_list"><div t-foreach="selectedInterconnections" t-as="link" t-key="link.id"><span><i t-att-style="'background:' + link.color"/><span><strong t-esc="connectionLabel(link)"/><small><t t-esc="connectionTypeLabel(link.cable_type)"/><t t-if="link.name"> · <t t-esc="link.name"/></t></small></span><button type="button" title="Eliminar interconexión" t-on-click="() => this.deleteInterconnection(link)"><i class="fa fa-times"/></button></span></div></div>
                        </section>
                        <div t-if="state.selectedEquipment.ports.length" class="o_fiber_cabinet_patch"><div class="o_fiber_cabinet_patch_title"><div><small>ASIGNACIÓN MANUAL</small><h3>Puertos de fibra</h3></div><span t-esc="state.selectedEquipment.ports.length"/></div>
                            <div class="o_fiber_cabinet_ports"><div t-foreach="ports" t-as="port" t-key="port.id" class="o_fiber_cabinet_port_row"><span class="o_fiber_cabinet_port_number" t-esc="port.number"/><span t-att-class="'o_fiber_cabinet_port_status ' + (port.fiber_id ? 'is-used' : '')" t-att-style="port.fiber_id ? 'background:' + port.fiber_color : ''"/><span t-if="port.fiber_id" class="o_fiber_cabinet_assigned_fiber"><span t-esc="port.fiber_label"/><button type="button" title="Liberar puerto" t-on-click="() => this.chooseFiber(port, false)"><i class="fa fa-times"/></button></span><button t-else="" type="button" class="o_fiber_cabinet_assign_button" t-on-click="() => this.openFiberPicker(port)"><i class="fa fa-plus me-1"/>Asignar fibra</button><div t-if="state.activeFiberPortId === port.id" class="o_fiber_cabinet_fiber_picker"><div class="o_fiber_cabinet_fiber_search"><input type="search" placeholder="Matrícula, cable o nodo…" t-att-value="state.fiberQuery" t-on-input="onFiberSearch" t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.searchFibers()"/><button type="button" t-att-disabled="state.fiberSearchLoading" t-on-click="searchFibers"><i t-att-class="state.fiberSearchLoading ? 'fa fa-spinner fa-spin' : 'fa fa-search'"/></button></div><div t-if="filteredFibers.length" class="o_fiber_cabinet_fiber_results"><button t-foreach="filteredFibers" t-as="fiber" t-key="fiber.id" type="button" t-on-click="() => this.chooseFiber(port, fiber.id)"><i t-att-style="'background:' + fiber.color"/><span><strong t-esc="fiber.label"/><small><t t-esc="fiber.cable"/> · <t t-esc="fiber.color_name"/></small></span><i class="fa fa-plus"/></button></div><small t-if="state.fiberResultsTruncated" class="o_fiber_cabinet_no_fibers">Hay más de 50 resultados. Afina la búsqueda.</small><small t-elif="state.fiberQuery.length &lt; 2" class="o_fiber_cabinet_no_fibers">Escribe al menos dos caracteres para buscar.</small><small t-elif="!filteredFibers.length &amp;&amp; !state.fiberSearchLoading" class="o_fiber_cabinet_no_fibers">Sin coincidencias para esta búsqueda.</small><button type="button" class="o_fiber_cabinet_picker_cancel" t-on-click="closeFiberPicker">Cerrar selector</button></div></div></div>
                            <div class="o_fiber_cabinet_fiber_hint"><i class="fa fa-info-circle"/> Las fibras ocupadas en otros puertos no aparecen disponibles.</div>
                        </div>
                        <div class="o_fiber_cabinet_inspector_spacer"/><small class="o_fiber_cabinet_remove_hint"><i class="fa fa-arrow-left me-1"/>Arrastra el equipo hacia la izquierda para retirarlo.</small>
                    </t>
                    <div t-else="" class="o_fiber_cabinet_inspector_empty"><div class="o_fiber_cabinet_empty_icon"><i class="fa fa-mouse-pointer"/></div><h3>Selecciona un equipo</h3><p>Al seleccionarlo podrás revisar sus unidades y asignar fibras a los puertos de los paneles.</p><div class="o_fiber_cabinet_legend"><span><i class="is-free"/>Boca libre</span><span><i class="is-used"/>Fibra conectada</span></div></div>
                </aside>
            </div>
            <div t-if="state.catalogEdit" class="o_fiber_cabinet_catalog_modal_backdrop" t-on-click="cancelCatalogEditor">
                <section class="o_fiber_cabinet_catalog_modal" role="dialog" aria-modal="true" aria-labelledby="o_fiber_cabinet_catalog_modal_title" t-on-click.stop="() => {}">
                    <header class="o_fiber_cabinet_catalog_modal_head"><div><small>CONFIGURACIÓN COMPARTIDA</small><h2 id="o_fiber_cabinet_catalog_modal_title">Editar elemento de la biblioteca</h2></div><button type="button" title="Cerrar" t-on-click="cancelCatalogEditor"><i class="fa fa-times"/></button></header>
                    <div class="o_fiber_cabinet_catalog_modal_body">
                        <div class="o_fiber_cabinet_catalog_modal_form">
                            <label class="o_fiber_cabinet_name_label">Nombre de plantilla<input type="text" maxlength="120" t-att-value="state.catalogEdit.name" t-on-input="(ev) => this.onCatalogEditInput(ev, 'name')"/></label>
                            <div class="o_fiber_cabinet_catalog_dimensions"><label>Altura al añadir (U)<input type="number" min="1" max="60" t-att-value="state.catalogEdit.height_u" t-on-input="(ev) => this.onCatalogEditInput(ev, 'height_u')"/></label><label>Bocas por equipo<input type="number" min="0" max="512" t-att-value="state.catalogEdit.port_count" t-on-input="(ev) => this.onCatalogEditInput(ev, 'port_count')"/></label></div>
                            <label class="o_fiber_cabinet_name_label">Imagen frontal<input type="file" accept="image/*" t-on-change="onCatalogImageChange"/></label>
                            <small class="o_fiber_cabinet_catalog_edit_hint">La imagen y las posiciones se aplican a los equipos instalados. El nombre y la altura se usan al añadir equipos nuevos. Si reduces las bocas, no se eliminarán conexiones existentes.</small>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="resetCatalogImage"><i class="fa fa-undo me-1"/>Usar imagen predeterminada</button>
                            <div class="o_fiber_cabinet_catalog_edit_actions"><button type="button" class="btn btn-light" t-on-click="cancelCatalogEditor">Cancelar</button><button type="button" class="btn btn-primary" t-att-disabled="state.saving" t-on-click="saveCatalogEditor"><i class="fa fa-check me-1"/>Guardar cambios</button></div>
                        </div>
                        <div class="o_fiber_cabinet_catalog_modal_preview"><div class="o_fiber_cabinet_catalog_preview_title"><strong>Vista frontal y posición de las bocas</strong><span><t t-esc="state.catalogEdit.port_count"/> bocas</span></div><div class="o_fiber_cabinet_catalog_preview" t-att-style="catalogEditPreviewStyle()" t-on-pointermove="moveCatalogPort" t-on-pointerup="stopCatalogPortDrag" t-on-pointercancel="stopCatalogPortDrag"><img t-if="state.catalogEdit.imagePreview || state.catalogEdit.image_url" t-att-src="state.catalogEdit.imagePreview || state.catalogEdit.image_url" alt="Vista previa del equipo"/><span t-else="" class="o_fiber_cabinet_catalog_preview_empty"><i t-att-class="kindIcon(state.catalogEdit.kind)"/></span><button t-foreach="catalogEditPorts()" t-as="number" t-key="number" type="button" class="o_fiber_cabinet_catalog_port_marker" t-att-style="catalogEditPortStyle(number)" t-att-title="'Boca ' + number" t-on-pointerdown="(ev) => this.startCatalogPortDrag(ev, number)"><t t-esc="number"/></button></div><small>Arrastra cada número hasta la toma correspondiente del dibujo.</small></div>
                    </div>
                </section>
            </div>
            <div t-if="state.confirmDeleteEquipment" class="o_fiber_cabinet_confirm_backdrop" t-on-click="() => this.state.confirmDeleteEquipment = null">
                <div class="o_fiber_cabinet_confirm_dialog" role="dialog" aria-modal="true" aria-labelledby="o_fiber_cabinet_remove_title" t-on-click.stop="() => {}">
                    <span class="o_fiber_cabinet_confirm_icon"><i class="fa fa-arrow-left"/></span>
                    <h2 id="o_fiber_cabinet_remove_title">Retirar del rack</h2>
                    <p>¿Quieres retirar <strong t-esc="state.confirmDeleteEquipment.name"/> del armario?</p>
                    <p t-if="connectedFibers(state.confirmDeleteEquipment) || connectedInterconnections(state.confirmDeleteEquipment)" class="o_fiber_cabinet_confirm_warning"><i class="fa fa-exclamation-triangle me-1"/>Se eliminarán <t t-esc="connectedFibers(state.confirmDeleteEquipment)"/> asignaciones de fibra y <t t-esc="connectedInterconnections(state.confirmDeleteEquipment)"/> interconexiones asociadas.</p>
                    <div class="o_fiber_cabinet_confirm_actions"><button class="btn btn-light" t-on-click="() => this.state.confirmDeleteEquipment = null">Cancelar</button><button class="btn btn-danger" t-on-click="confirmRemoveEquipment"><i class="fa fa-arrow-left me-1"/> Retirar equipo</button></div>
                </div>
            </div>
        </div>
    </t>
</templates>
